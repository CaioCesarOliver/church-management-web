# Base URL of the API (apps/api). Must be reachable from the BROWSER, because the
# client components fetch it directly — that is why it is NEXT_PUBLIC_.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Identifica o ambiente na interface. Deixe em branco ou use "production" em
# produção; qualquer outro valor ("hml", "dev") desenha uma faixa de aviso no
# topo da tela, para ninguém cadastrar dado real no ambiente errado.
NEXT_PUBLIC_APP_ENV="hml"
